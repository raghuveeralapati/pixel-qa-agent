# Normalize line endings across OS (Windows/Mac/Linux)
* text=auto

# Python files
*.py text diff=python

# Documentation
*.md text
*.txt text

# Images (used in samples folder - binary)
*.png binary
*.jpg binary

# Shell & scripts
*.sh text eol=lf
*.bat text eol=crlf

# Prevent diff noise for images and binaries
*.zip binary
*.csv text